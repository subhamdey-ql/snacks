generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmpType {
  HYBRID
  WFO
}

// Which side of the app a person gets after login. Only changed directly in the database (never via the UI or a CSV).
enum UserRole {
  ADMIN
  USER
}

model Employee {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         EmpType
  active       Boolean       @default(true)
  // Login identity. Required by the app; nullable in the database only so employees created before V2 survive the migration.
  email        String?       @unique
  role         UserRole      @default(USER)
  consumptions Consumption[]

  // Search/list filters on active and orders by name.
  @@index([active, name])
}

model Snack {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  credits      Int
  active       Boolean       @default(true)
  consumptions Consumption[]
  menuDays     DailyMenu[]

  @@index([active, name])
}

// Append-only history: the row with the latest effectiveFrom <= a month's start applies to that month.
model Allowance {
  id            Int      @id @default(autoincrement())
  type          EmpType
  credits       Int
  effectiveFrom DateTime

  @@unique([type, effectiveFrom])
}

model Consumption {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  snackId        Int
  qty            Int
  creditsCharged Int
  createdAt      DateTime  @default(now())
  voidedAt       DateTime?
  employee       Employee  @relation(fields: [employeeId], references: [id])
  snack          Snack     @relation(fields: [snackId], references: [id])

  // Balance: one employee, not voided, within a month.
  @@index([employeeId, voidedAt, createdAt])
  // Reports: all employees, not voided, within a month.
  @@index([createdAt, voidedAt])
  // Employee month entries list (all rows, voided included).
  @@index([employeeId, createdAt])
}

// One-time login codes. Only a hash of the code is stored; a row is single use and expires after 10 minutes.
model OtpCode {
  id        Int       @id @default(autoincrement())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Snacks the uncle marked available on a day. `date` is that IST day's start (as a UTC instant).
model DailyMenu {
  date    DateTime
  snackId Int
  snack   Snack    @relation(fields: [snackId], references: [id])

  @@id([date, snackId])
  @@index([date])
}

// Not used by any code yet (rate limiting is on hold); kept so the schema matches the table created by the
// 20260930180000_rate_limit migration and Prisma does not try to drop it.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
